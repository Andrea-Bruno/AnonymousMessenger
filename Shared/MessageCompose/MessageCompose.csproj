<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Configurations>Debug;Release</Configurations>
    <NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MPowerKit.Lottie" Version="1.2.0" />
    <PackageReference Include="CommunityToolkit.Maui" Version="14.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Localization\Localization.csproj" />
    <ProjectReference Include="..\Utils\Utils.csproj" />
    <ProjectReference Include="..\CustomViewElements\CustomViewElements.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Composer.xaml.cs">
      <DependentUpon>Composer.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Composer.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
  </ItemGroup>

 
  <ItemGroup>
    <None Remove="xFFmpeg.NET" />
  </ItemGroup>
</Project>
