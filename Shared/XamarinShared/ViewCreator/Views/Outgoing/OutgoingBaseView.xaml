<?xml version="1.0" encoding="UTF-8" ?>
<vc:BaseView
    x:Class="XamarinShared.ViewCreator.Views.Outgoing.OutgoingBaseView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:customviews="clr-namespace:XamarinShared.CustomViews"
    xmlns:vc="clr-namespace:XamarinShared.ViewCreator">
    <vc:BaseView.Resources>
        <vc:MessageSelectionMarginConverter x:Key="marginConverter" />
    </vc:BaseView.Resources>
    <vc:BaseView.Content>


        <Grid
            Margin="15,3,15,3"
            Padding="3"
            BackgroundColor="Transparent"
            HorizontalOptions="FillAndExpand"
            MinimumHeightRequest="200">

            <customviews:CustomCheckBox
                x:Name="CheckBox"
                Margin="0,0,8,0"
                x:FieldModifier="Public"
                BackgroundColor="Transparent"
                HeightRequest="20"
                HorizontalOptions="Start"
                IsChecked="False"
                IsVisible="{Binding IsMessageSelection}"
                WidthRequest="20" />
            <StackLayout
                Margin="35,0,0,0"
                Orientation="Vertical"
                HorizontalOptions="Fill">

                <Border
                    x:Name="PancakeView"
                    Padding="0"
                    x:FieldModifier="Public"
                    StrokeShape="RoundRectangle 15,15,15,0"
                    HorizontalOptions="FillAndExpand"
                    MinimumHeightRequest="200"
                    VerticalOptions="FillAndExpand">
                    <Border.Shadow>
                        <Shadow
                            x:Name="DropShadow"
                            Radius="5"
                            Offset="10,10"
                            Brush="Black" />
                    </Border.Shadow>
                </Border>
            </StackLayout>
        </Grid>
    </vc:BaseView.Content>
</vc:BaseView>
