<?xml version="1.0" encoding="UTF-8" ?>
<ts:BaseView
    x:Class="XamarinShared.ViewCreator.Views.Incoming.BaseIncomingView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:customviews="clr-namespace:XamarinShared.CustomViews"
    xmlns:ts="clr-namespace:XamarinShared.ViewCreator">
    <ContentView.Resources>
        <ts:MessageSelectionMarginConverter x:Key="marginConverter" />
    </ContentView.Resources>
    <ContentView.Content>
        <Grid
            Margin="15,3,50,3"
            Padding="3"
            BackgroundColor="Transparent"
            HorizontalOptions="FillAndExpand"
            MinimumHeightRequest="200">

            <customviews:CustomCheckBox
                x:Name="CheckBox"
                Margin="0,0,8,-40"
                x:FieldModifier="Public"
                BackgroundColor="Transparent"
                HeightRequest="20"
                HorizontalOptions="Start"
                IsChecked="False"
                IsVisible="{Binding IsMessageSelection}"
                WidthRequest="20" />


            <StackLayout
                Margin="{Binding IsMessageSelection, Converter={StaticResource marginConverter}}"
                Orientation="Vertical"
                HorizontalOptions="Fill">
                <!--  Margin="{Binding Source={x:Reference CheckBox},Path=Height,Converter=}"  -->
                <Border
                    x:Name="PancakeView"
                    Padding="0"
                    x:FieldModifier="Public"
                    StrokeShape="RoundRectangle 15,15,0,15"
                    HorizontalOptions="FillAndExpand"
                    MinimumHeightRequest="200"
                    VerticalOptions="FillAndExpand">
                    <Border.Shadow>
                        <Shadow
                            x:Name="DropShadow"
                            Radius="5"
                            Offset="10,10"
                            Brush="Black" />
                    </Border.Shadow>
                </Border>

            </StackLayout>

        </Grid>
    </ContentView.Content>
</ts:BaseView>
